GEMINI_API_KEY=replace_with_rotated_Gemini_key
CLOUDFLARE_API_TOKEN=replace_with_rotated_Cloudflare_token
CLOUDFLARE_ACCOUNT_ID=your_Cloudflare_account_id
CLOUDFLARE_PLANNER_MODEL=@cf/meta/llama-3.1-8b-instruct
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_STORE=false
HTTP_TIMEOUT_SECONDS=90
SMART_AI_QUOTAS_FILE=~/.smart_ai/quotas.json
SMART_AI_LIMIT_STATE_FILE=~/.smart_ai/limit_state.json
